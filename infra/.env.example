# ---- App ----
KEYSTONE_ENV=development

# ---- Postgres (M1.1) ----
POSTGRES_USER=keystone
POSTGRES_PASSWORD=keystone
POSTGRES_DB=keystone
KEYSTONE_DATABASE_URL=postgresql+psycopg://keystone:keystone@postgres:5432/keystone

# ---- Redis (M1.1) ----
KEYSTONE_REDIS_URL=redis://redis:6379/0

# ---- S3 object store (M1.1) ----
# The compose `s3` service (VersityGW) takes its root credentials from the
# access/secret key below, so the app and the store always agree.
KEYSTONE_S3_ENDPOINT=http://s3:7070
KEYSTONE_S3_BUCKET=keystone
KEYSTONE_S3_ACCESS_KEY=keystone
KEYSTONE_S3_SECRET_KEY=keystone-dev-secret

# ---- Auth (M1.4) ----
KEYSTONE_JWT_SECRET=change-me-in-prod
KEYSTONE_ACCESS_TTL_MIN=15
KEYSTONE_REFRESH_TTL_DAYS=14

# ---- First-run admin (M1.3) ----
KEYSTONE_ADMIN_USERNAME=admin
KEYSTONE_ADMIN_EMAIL=admin@keystone.local
KEYSTONE_ADMIN_PASSWORD=change-me

# ---- ghidra-headless-mcp (its own repository; set it up and start it first) ----
# The worker calls its --http service's /api on the Docker host
# (host.docker.internal) and sends each binary there as raw bytes; the two stacks
# share nothing else. Use its GHMCP_HTTP_PORT if it changed the port.
KEYSTONE_MCP_ENDPOINT=http://host.docker.internal:1351/api
# Must equal GHMCP_API_KEY in ghidra-headless-mcp's .env — the bearer token the
# worker sends. Generate once, there: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
KEYSTONE_MCP_API_KEY=
# Uploads above its MAX_STREAM_UPLOAD_BYTES (128 MiB by default) fail at analysis
# time with "too_large"; keep it at least KEYSTONE_UPLOAD_MAX_BYTES (100 MiB).

# ---- LLM (set at runtime in system settings; key is a deployment secret) ----
KEYSTONE_LLM_API_KEY=
